@model List<string[]>
<!-- 
This displays the log file for RealEstateRCL
-->

@{
    ViewData["RCL"] = "RealEstate";
    ViewData["Title"] = "Page Hits Log";
}

<span style="font-family: 'Arial Narrow', Arial, Helvetica, sans-serif;font-weight:normal;font-size:small">

<h4>@ViewData["RCL"] @ViewData["PageName"] @ViewData["Title"]</h4>

@if (Model.Count == 0)
{
    <p>No hits recorded yet.</p>
}
else
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>When (Central Time)</th>
               
                <th>From Where</th>
                <th>Device</th>
            </tr>
        </thead>
        <tbody>
        @foreach (var parts in Model)
        {
            <tr>
                <td>@(parts.Length > 0 ? parts[0].Trim() : "")</td>
              
                <td>@(parts.Length > 2 ? parts[2].Trim() : "")</td>
                <td>@(parts.Length > 3 ? parts[3].Trim() : "")</td>
            </tr>
        }
        </tbody>

    </table>
}


</span>