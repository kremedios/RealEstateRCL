    <title>Property Listing</title>

    <style>

        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            font-family: Arial, sans-serif;
            line-height: 1.5;
            background-color: #f4f4f4;
            color: #222;
        }

        .container {
            max-width: 1200px;
            margin: auto;
            padding: 20px;
        }

        h1, h2 {
            margin-top: 0;
        }

        /* ---------------------------------
           PROPERTY SUMMARY
        --------------------------------- */

        .property-summary {
            background: white;
            padding: 20px;
            border-radius: 8px;
            margin-bottom: 24px;
        }

        .property-summary ul {
            margin: 0;
            padding-left: 20px;
        }

        /* ---------------------------------
           GALLERY GRID
        --------------------------------- */

        .gallery-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
            gap: 16px;
        }

        .gallery-grid img {
            width: 100%;
            height: 220px;
            object-fit: cover;
            border-radius: 8px;
            display: block;
            transition: transform 0.2s ease;
        }

        .gallery-grid img:hover {
            transform: scale(1.02);
        }

        .gallery-grid a {
            text-decoration: none;
        }

        /* ---------------------------------
           LIGHTBOX / LARGE IMAGE VIEW
           Pure CSS using :target
        --------------------------------- */

        .lightbox {
            position: fixed;
            inset: 0;
            background: rgba(0,0,0,0.9);
            display: none;
            align-items: center;
            justify-content: center;
            padding: 20px;
            z-index: 1000;
        }

        .lightbox:target {
            display: flex;
        }

        .lightbox-content {
            position: relative;
            width: 100%;
            max-width: 1000px;
            text-align: center;
        }

        .lightbox img {
            width: 100%;
            max-height: 80vh;
            object-fit: contain;
            border-radius: 8px;
        }

        .caption {
            color: white;
            margin-top: 12px;
            font-size: 1rem;
        }

        /* ---------------------------------
           NAVIGATION ARROWS
        --------------------------------- */

        .nav-arrow {
            position: absolute;
            top: 50%;
            transform: translateY(-50%);
            color: white;
            font-size: 3rem;
            text-decoration: none;
            padding: 10px;
            user-select: none;
        }

        .nav-left {
            left: -60px;
        }

        .nav-right {
            right: -60px;
        }

        /* ---------------------------------
           CLOSE BUTTON
        --------------------------------- */

        .close-btn {
            position: absolute;
            top: -50px;
            right: 0;
            color: white;
            text-decoration: none;
            font-size: 2rem;
        }

        /* ---------------------------------
           DETAILS SECTION
        --------------------------------- */

        .property-details {
            background: white;
            padding: 20px;
            border-radius: 8px;
            margin-top: 24px;
        }

        .property-details ul {
            margin: 0;
            padding-left: 20px;
        }

        /* ---------------------------------
           MOBILE ADJUSTMENTS
        --------------------------------- */

        @@media (max-width: 768px) {

            .nav-left {
                left: 10px;
            }

            .nav-right {
                right: 10px;
            }

            .nav-arrow {
                font-size: 2.2rem;
            }

            .gallery-grid img {
                height: 180px;
            }
        }






.info-button {
    padding: 10px 18px;
    border: none;
    border-radius: 8px;
    cursor: pointer;
    font-size: 1rem;
}

.neighborhood-dialog {
    width: min(700px, 90%);
    border: none;
    border-radius: 12px;
    padding: 24px;
}

.neighborhood-dialog::backdrop {
