}

.dialog-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 18px;
}

.close-button {
    border: none;
    background: none;
    font-size: 1.4rem;
    cursor: pointer;
}




    </style>


</head>

