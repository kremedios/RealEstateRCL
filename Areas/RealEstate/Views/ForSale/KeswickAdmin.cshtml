
@model AppContractsSCO.Models.RealEstate.ForSale.ForSaleSettings

@{
    ViewData["Title"] = "Keswick Admin";
}

<h2>Keswick Administration</h2>

<p>
    Pressing <b>Save</b> button immediately &amp; automatically updates the web page with the new values.
</p>

<form asp-action="KeswickAdmin" method="post">

    @Html.AntiForgeryToken()

    <div style="margin-bottom:10px;">
        <label style="display:block;font-size:small;color:#666;">Price</label>
        <input asp-for="Price"
               style="width:250px;padding:4px;" />
    </div>

    <div style="margin-bottom:10px;">
        <label style="display:block;font-size:small;color:#666;">Availability</label>
        <input asp-for="Availability"
               style="width:250px;padding:4px;" />
    </div>





<h3>Description Blocks</h3>

@for (int i = 0; i < Model.ContactBlocks.Count; i++)
{
    <div style="margin-bottom:10px;">
        <textarea asp-for="ContactBlocks[i]"
                  rows="2"
                  style="width:700px;"></textarea>
    </div>
}






    <button type="submit"
            style="margin-top:10px;padding:6px 12px;">
        Save & View Updated Webpage
    </button>

    <button type="button"
            onclick="window.location.href='@Url.Action("Keswick", "ForSale", new { area = "RealEstate" })';"
            style="margin-bottom:1em;">
        Cancel
    </button>

</form>


<hr/><hr/>



<form asp-area="RealEstate"
      asp-controller="Logs"
      asp-action="PageHits"
      method="get">

    <input type="hidden" name="pageName" value="Keswick" />

    <button type="submit" style="margin-top:10px;padding:6px 12px;margin-bottom:1em;">
        Page Hits Details
    </button>
</form>


<form asp-area="Realestate"
      asp-controller="ForSale"
      asp-action="Keswick"
      method="get">

    <button type="submit" style="margin-top:10px;padding:6px 12px;margin-bottom:1em;">
        Go to Home Page
    </button>
</form>



@if (ViewBag.Message != null)
{
    <p style="color:green;margin-top:10px;">
        @ViewBag.Message
    </p>
}