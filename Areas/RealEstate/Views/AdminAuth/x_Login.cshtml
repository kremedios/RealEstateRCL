@{
    ViewData["Title"] = "Keswick Admin Login";
}

<h2>Keswick Administration Login</h2>

@if (ViewBag.Error != null)
{
    <div style="color:red;margin-bottom:10px;">
        @ViewBag.Error
    </div>
}

<form method="post" asp-action="Login" asp-controller="AdminAuth" asp-area="RealEstate">

    @Html.AntiForgeryToken()

    <div style="margin-bottom:10px;">
        <label>Username</label><br />
        <input type="text" name="username" style="width:250px;" />
    </div>

    <div style="margin-bottom:10px;">
        <label>Password</label><br />
        <input type="password" name="password" style="width:250px;" />
    </div>

    <button type="submit">
        Login
    </button>

</form>